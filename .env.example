# ─── LEXINODE — configuration (copiez ce fichier en .env) ───────────────────────
# Rien n'est obligatoire : sans clé, le moteur local fonctionne entièrement hors ligne.

PORT=5177
# HOST=0.0.0.0            # pour accéder à Lexinode depuis un autre appareil du réseau

# ─── IA « frontière » (API payantes) ───
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FALLBACKS=off  # désactive le repli automatique en cas de refus (modèles Claude 5.x)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5       # ou un modèle Codex disponible sur votre compte
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# ─── 100 % open source, à la maison ───
# Ollama (https://ollama.com) : ollama pull qwen3:14b
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:14b
# OLLAMA_NUM_CTX=16384
# Tout serveur compatible OpenAI : LM Studio, llama.cpp (llama-server), vLLM, LocalAI, Jan, OpenRouter, Mistral…
# COMPAT_BASE_URL=http://127.0.0.1:1234/v1
# COMPAT_MODEL=local-model
# COMPAT_API_KEY=
# COMPAT_JSON_MODE=off     # si votre serveur refuse response_format

# ─── fal.ai : UNE seule clé pour tout ───
# Génération vidéo (Wan 3.0, Seedance 2.5, MiniMax H3, identifiants préremplis)
# + agents texte via OpenRouter sur fal (fournisseur « fal.ai » dans Réglages)
FAL_KEY=
# FAL_LLM_MODEL=google/gemini-2.5-flash

# ─── VPS : protéger l'appli par mot de passe (fortement conseillé en ligne) ───
# LEXINODE_PASSWORD=
# LEXINODE_USER=moi
# HOST=0.0.0.0
# Appels directs (facultatif)
# MINIMAX_API_KEY=     # MiniMax H3 : https://api.minimax.io
# DASHSCOPE_API_KEY=   # Alibaba Wan 3.0 (bêta sur demande) : https://dashscope-intl.aliyuncs.com

# ─── Recherche web pour l'agent « chercheur » ───
# SearXNG (métamoteur open source auto-hébergé, voir docker-compose.yml)
# SEARXNG_URL=http://127.0.0.1:8888
# TAVILY_API_KEY=
# BRAVE_API_KEY=
